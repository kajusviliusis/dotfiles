{
    "layer": "top",
    "position": "top",
    "modules-left": ["sway/workspaces", "window"],
    "modules-center": [],
    "modules-right": ["network", "tray", "pulseaudio", "battery", "clock"],

    "sway/workspaces": {
        "all-outputs": true
    },

    "window": {
        "format": "{title}",
        "max-length": 50
    },

    "clock": {
        "format": "{:%a %d %b %H:%M}",
        "tooltip-format": "{:%A %d %B %Y}"
    },

    "battery": {
        "format": "bat {capacity}%",
        "format-charging": "bat ⚡ {capacity}%",
        "format-discharging": "bat {capacity}%"
    },

    "pulseaudio": {
        "format": "vol {volume}%",
        "format-muted": "vol muted",
        "on-click": "pavucontrol"
    },

    "network": {
        "format-wifi": "{essid}",
        "format-ethernet": "{ifname}"
    },

    "tray": {
        "icon-theme": "Papirus-Dark",
        "pin": true
    }
}
